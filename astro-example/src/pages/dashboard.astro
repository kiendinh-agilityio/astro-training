---
import Layout from "../layouts/Layout.astro";

// This page is also protected by authentication middleware
const requestId = Astro.locals.requestId;
const geoData = Astro.locals.geo;
---

<Layout title="User Dashboard">
  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">📊 User Dashboard</h1>

        <div
          class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6"
        >
          <strong>Welcome!</strong> You have successfully accessed the protected
          dashboard area.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div class="bg-blue-50 p-4 rounded">
            <h2 class="text-lg font-semibold mb-2 text-blue-800">
              Authentication
            </h2>
            <p class="text-green-600">✅ Authenticated</p>
            <p class="text-sm text-gray-600">Request ID: {requestId}</p>
          </div>

          <div class="bg-purple-50 p-4 rounded">
            <h2 class="text-lg font-semibold mb-2 text-purple-800">Location</h2>
            <p class="text-purple-600">🌍 {geoData?.country}</p>
            <p class="text-sm text-gray-600">IP: {geoData?.ip}</p>
          </div>

          <div class="bg-orange-50 p-4 rounded">
            <h2 class="text-lg font-semibold mb-2 text-orange-800">
              Protection
            </h2>
            <p class="text-orange-600">🛡️ Middleware Protected</p>
            <p class="text-sm text-gray-600">Secure access only</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-gray-50 p-6 rounded">
            <h2 class="text-xl font-semibold mb-4">Dashboard Features</h2>
            <ul class="space-y-2">
              <li class="flex items-center">
                <span class="text-green-500 mr-2">✓</span>
                Protected by authentication middleware
              </li>
              <li class="flex items-center">
                <span class="text-green-500 mr-2">✓</span>
                Request tracking with unique ID
              </li>
              <li class="flex items-center">
                <span class="text-green-500 mr-2">✓</span>
                Geo-location detection
              </li>
              <li class="flex items-center">
                <span class="text-green-500 mr-2">✓</span>
                Security headers applied
              </li>
            </ul>
          </div>

          <div class="bg-gray-50 p-6 rounded">
            <h2 class="text-xl font-semibold mb-4">Middleware Data</h2>
            <div class="space-y-2 text-sm">
              <div><strong>Request ID:</strong> {requestId}</div>
              <div><strong>Country:</strong> {geoData?.country}</div>
              <div><strong>City:</strong> {geoData?.city}</div>
              <div><strong>IP Address:</strong> {geoData?.ip}</div>
              <div><strong>Timezone:</strong> {geoData?.timezone}</div>
            </div>
          </div>
        </div>

        <div class="mt-8 flex space-x-4">
          <a
            href="/blog"
            class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
          >
            ← Back to Examples
          </a>
          <a
            href="/admin"
            class="inline-block bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600"
          >
            Admin Panel →
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
