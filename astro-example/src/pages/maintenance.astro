---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Maintenance Mode">
  <main class="min-h-screen bg-gray-900 flex items-center justify-center">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="bg-white rounded-lg shadow-xl p-8">
        <!-- Maintenance Icon -->
        <div class="mb-6">
          <div class="mx-auto w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
        </div>
        
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          🔧 Maintenance Mode
        </h1>
        
        <p class="text-gray-600 mb-6">
          We're currently performing scheduled maintenance to improve your experience. 
          Please check back in a few minutes.
        </p>
        
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
          <h2 class="text-lg font-semibold text-yellow-800 mb-2">What's happening?</h2>
          <p class="text-yellow-700 text-sm">
            This page is displayed when <code class="bg-yellow-100 px-1 rounded">MAINTENANCE_MODE=true</code> 
            is set in your environment variables. The maintenance middleware automatically 
            redirects all requests to this page.
          </p>
        </div>
        
        <div class="space-y-3">
          <div class="text-sm text-gray-500">
            <strong>Expected downtime:</strong> 15-30 minutes
          </div>
          <div class="text-sm text-gray-500">
            <strong>Last updated:</strong> {new Date().toLocaleString()}
          </div>
        </div>
        
        <div class="mt-8">
          <button 
            onclick="location.reload()" 
            class="bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600 transition-colors"
          >
            🔄 Refresh Page
          </button>
        </div>
        
        <div class="mt-6 text-xs text-gray-400">
          <p>To disable maintenance mode, set <code>MAINTENANCE_MODE=false</code> in your environment variables.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>
