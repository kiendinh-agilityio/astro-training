---
import Layout from "../layouts/Layout.astro";
import RiveNetworkAnimation from "../components/RiveNetworkAnimation";
import ResponsiveImage from "../components/ResponsiveImage.astro";
---

<Layout title="Welcome to Astro.">
  <main>
    <!-- Example usage of the responsive image component -->
    <ResponsiveImage
      src="../../public/images/main-bg.png"
      alt="Sample responsive image"
    />

    <!-- Background network animation powered by Rive (client-only to skip SSR) -->
    <RiveNetworkAnimation client:only="react" className="network-bg" />
  </main>
</Layout>
