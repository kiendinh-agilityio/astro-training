---
import Heading from "../components/Heading.astro";
// import RiveNetworkAnimation from "../components/RiveNetworkAnimation.tsx";
import LottieAnimation from "../components/LottieAnimation.tsx";
---

<section
  class="min-h-screen flex flex-col items-center justify-center relative overflow-hidden text-center"
>
  <!-- Animation -->
  <LottieAnimation client:only="react" />

  <div class="absolute bottom-0 mx-auto pb-[64px]">
    <Heading
      level={1}
      class="text-white text-4xl md:text-5xl lg:leading-[64px] font-bold leading-tight drop-shadow-md text-center mb-6"
    >
      Lorem Ipsum Dolor Sit Amet
    </Heading>
    <p
      class="text-white text-lg md:text-xl text-center max-w-[592px] mx-auto font-normal"
    >
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla facilisi.
      Integer vitae sapien ut libero venenatis faucibus.
    </p>
  </div>
</section>
