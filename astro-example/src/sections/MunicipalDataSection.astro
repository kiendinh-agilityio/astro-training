---
import Heading from "../components/Heading.astro";
import Paragraph from "../components/Paragraph.astro";
import Accordion from "../components/Accordion";
import { ACCORDION_DATA } from "../data/data.ts";
---

<section class="min-h-screen py-16 flex items-center">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex gap-28">
      <!-- Left Content Area -->
      <div class="space-y-8">
        <Heading
          level={1}
          class="text-white text-3xl lg:text-4xl font-bold leading-tight"
        >
          Innovating the Future of Design
        </Heading>
        <Paragraph
          class="text-white text-md lg:text-lg leading-relaxed opacity-90 max-w-lg font-normal"
        >
          Transform your digital presence with innovative solutions designed to
          empower creativity and enhance performance.
        </Paragraph>
      </div>

      <!-- Right Content Area -->
      <Accordion client:load items={ACCORDION_DATA} />
    </div>
  </div>
</section>
