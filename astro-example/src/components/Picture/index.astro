---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  formats?: ("webp" | "avif" | "png" | "jpeg")[];
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "auto" | "sync";
  quality?: number; // 1-100
  fit?: "cover" | "contain" | "fill" | "inside" | "outside";
  position?:
    | "top"
    | "right top"
    | "right"
    | "right bottom"
    | "bottom"
    | "left bottom"
    | "left"
    | "left top"
    | "center";
  // Responsive breakpoints
  mobileWidth?: number;
  tabletWidth?: number;
  desktopWidth?: number;
}

const {
  src,
  alt,
  widths = [320, 480, 640, 768, 1024, 1280, 1536, 1920],
  sizes = "(max-width: 480px) 100vw, (max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw",
  formats = ["avif", "webp", "png", "jpeg"],
  class: className,
  loading = "lazy",
  decoding = "async",
  quality = 80,
  fit = "cover",
  position = "center",
  mobileWidth = 320,
  tabletWidth = 768,
  desktopWidth = 1200,
} = Astro.props as Props;

const isExternal = typeof src === "string";

// Generate responsive sizes string if not provided
const responsiveSizes =
  sizes ||
  `(max-width: ${mobileWidth}px) 100vw, (max-width: ${tabletWidth}px) 50vw, ${desktopWidth}px`;
---

{
  isExternal ? (
    <picture class={className}>
      <source
        media="(max-width: 480px)"
        srcset={`${src}?w=320&q=${quality}`}
        type="image/webp"
      />
      <source
        media="(max-width: 768px)"
        srcset={`${src}?w=768&q=${quality}`}
        type="image/webp"
      />
      <source
        media="(max-width: 1024px)"
        srcset={`${src}?w=1024&q=${quality}`}
        type="image/webp"
      />
      <img
        src={src as string}
        alt={alt}
        loading={loading}
        decoding={decoding}
        class={className}
        sizes={responsiveSizes}
      />
    </picture>
  ) : (
    <Picture
      src={src as ImageMetadata}
      alt={alt}
      widths={widths}
      sizes={responsiveSizes}
      formats={formats}
      loading={loading}
      decoding={decoding}
      quality={quality}
      fit={fit}
      position={position}
      class={className}
    />
  )
}
