---
export interface HeadingProps {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
}

const { level = 1, class: className = "" } = Astro.props as HeadingProps;

const tag = `h${level}` as keyof HTMLElementTagNameMap;
---

<Fragment>
  {
    tag === "h1" && (
      <h1 class={className}>
        <slot />
      </h1>
    )
  }
  {
    tag === "h2" && (
      <h2 class={className}>
        <slot />
      </h2>
    )
  }
  {
    tag === "h3" && (
      <h3 class={className}>
        <slot />
      </h3>
    )
  }
  {
    tag === "h4" && (
      <h4 class={className}>
        <slot />
      </h4>
    )
  }
  {
    tag === "h5" && (
      <h5 class={className}>
        <slot />
      </h5>
    )
  }
  {
    tag === "h6" && (
      <h6 class={className}>
        <slot />
      </h6>
    )
  }
</Fragment>
