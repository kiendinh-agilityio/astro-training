---
import type { APIContent } from "@prismicio/client";
import { asText } from "@prismicio/helpers";
import ResponsiveImage from "../ResponsiveImage.astro";
import Heading from "../Heading.astro";
import Button from "../Button/Button.astro";

interface Props {
  slice: APIContent["data"][string];
}

const { slice } = Astro.props as Props;
const title = asText(slice?.primary?.title) || "";
const description = asText(slice?.primary?.description) || "";
const image = slice?.primary?.image as any;
const buttonLabel = slice?.primary?.button_label as string | undefined;
const buttonLink = slice?.primary?.button_link?.url as string | undefined;
---

<section class="hero">
  {
    image?.url && (
      <div class="hero__media">
        <ResponsiveImage src={image.url} alt={image.alt || ""} />
      </div>
    )
  }

  <div class="hero__overlay">
    {
      title && (
        <Heading level={1} class="hero__title">
          {title}
        </Heading>
      )
    }
    {description && <p class="hero__description">{description}</p>}
    {
      buttonLabel &&
        (buttonLink ? (
          <a href={buttonLink} rel="noopener noreferrer">
            <Button className="btn">{buttonLabel}</Button>
          </a>
        ) : (
          <Button className="btn">{buttonLabel}</Button>
        ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 1040px;
    overflow: hidden;
  }

  /* Full-bleed on small screens */
  @media (max-width: 768px) {
    .hero {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      min-height: 60vh;
    }
  }

  .hero__media :global(img),
  .hero__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__overlay {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    align-items: center;
    justify-items: start;
    padding: 3rem 1rem;
    color: #fff;
  }
  .hero__title,
  .hero__description {
    color: #fff;
  }
  .btn {
    background: #6c4ad0;
    color: white;
    border-radius: 8px;
  }
  a {
    text-decoration: none;
  }
</style>
