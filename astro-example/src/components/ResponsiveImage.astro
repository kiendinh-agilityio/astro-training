---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  formats?: ("webp" | "avif" | "png" | "jpeg")[];
  class?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "auto" | "sync";
  quality?: number; // 1-100
}

const {
  src,
  alt,
  widths = [320, 480, 640, 768, 1024, 1280, 1536],
  sizes = "(max-width: 768px) 100vw, 768px",
  formats = ["webp", "png", "jpeg"],
  class: className,
  loading = "lazy",
  decoding = "async",
  quality = 80,
} = Astro.props as Props;

const isExternal = typeof src === "string";
---

{
  isExternal ? (
    <img
      src={src as string}
      alt={alt}
      loading={loading}
      decoding={decoding}
      class={className}
      sizes={sizes}
    />
  ) : (
    <Picture
      src={src as ImageMetadata}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={formats}
      loading={loading}
      decoding={decoding}
      quality={quality}
      class={className}
    />
  )
}
