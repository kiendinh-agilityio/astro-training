---
import { MainLayout } from '@/layouts';
import { HomeSkeleton } from '@/components';
import { Hero, Blog } from '@/sections';
import {
  getActiveSiteLanguage,
  getCachedBlogPosts,
  getCachedBlogSectionSettings,
} from '@/utils';

const activeLanguage = await getActiveSiteLanguage(Astro.cookies);
const [posts, blogSectionSettings] = await Promise.all([
  getCachedBlogPosts(undefined, Astro.cookies),
  getCachedBlogSectionSettings(activeLanguage),
]);

const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const trendingPosts = featuredPost
  ? posts.filter((post) => post.slug !== featuredPost.slug)
  : posts;
---

<MainLayout>
  <HomeSkeleton client:only="react">
    <Hero post={featuredPost} />
    <Blog
      posts={trendingPosts}
      trendingPostTitle={blogSectionSettings.trendingPostTitle}
      trendingPostDescription={blogSectionSettings.trendingPostDescription}
    />
  </HomeSkeleton>
</MainLayout>
