---
import { MainLayout } from '@/layouts';
import { HomeSkeleton } from '@/components';
import { Hero, Blog } from '@/sections';
import { getCachedBlogPosts } from '@/utils';

const page = Number(Astro.url.searchParams.get('page')) || 1;
const cachedPosts = getCachedBlogPosts();
---

<MainLayout>
  <HomeSkeleton client:load>
    <Hero />
    <Blog currentPage={page} posts={cachedPosts} />
  </HomeSkeleton>
</MainLayout>
