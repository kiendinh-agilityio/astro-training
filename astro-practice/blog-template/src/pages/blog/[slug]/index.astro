---
import type { GetStaticPaths } from 'astro';

import { BlogSkeleton } from '@/components';
import { MainLayout } from '@/layouts';
import { BlogDetail } from '@/sections';
import { getBlogPostBySlug, getCachedBlogPosts } from '@/utils';
import { ROUTER } from '@/constants';

export const getStaticPaths = (async () => {
  // Generate paths for both languages
  const postsEn = await getCachedBlogPosts('en');
  const postsVi = await getCachedBlogPosts('vi');
  const allPosts = [...postsEn, ...postsVi];

  return allPosts
    .filter((post) => post.slug)
    .map((post) => ({
      params: { slug: post.slug },
    }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug;
const post = slug
  ? await getBlogPostBySlug(slug, undefined, Astro.cookies)
  : null;

if (!post) {
  return Astro.redirect(ROUTER.HOME);
}
---

<MainLayout
  title={post.title ?? 'Blog Template'}
  description={post.introduction ?? 'Welcome to our blog'}
  url={Astro.url.href}
  theme={post.theme}
>
  <BlogSkeleton client:load>
    <BlogDetail post={post} />
  </BlogSkeleton>
</MainLayout>
