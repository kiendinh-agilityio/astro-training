---
import './index.css';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cn } from '@/utils';

interface LazyImageProps {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  className?: string;
  imageClassName?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  quality?: number;
  format?: 'webp' | 'jpeg' | 'png' | 'avif';
}

const {
  src,
  alt,
  width,
  height,
  className,
  imageClassName,
  loading = 'lazy',
  priority = false,
  quality = 75,
  format = 'webp',
} = Astro.props as LazyImageProps;
---

<div
  class={cn(
    `image-wrapper w-[${width}px] h-[${height}px] bg-gray-100`,
    className,
  )}
>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={priority ? 'high' : 'auto'}
    quality={quality}
    format={format}
    class={cn('block h-full w-full object-cover', imageClassName)}
  />
</div>
