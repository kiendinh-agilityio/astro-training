---
import './index.css';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import type { SupportedImageSource } from '@/types';
import { cn, getSanityImageUrl } from '@/utils';

interface LazyImageProps {
  src?: SupportedImageSource;
  alt: string;
  width: number;
  height: number;
  className?: string;
  imageClassName?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  quality?: number;
  format?: 'webp' | 'jpg' | 'png';
}

const {
  src,
  alt,
  width,
  height,
  className,
  imageClassName,
  loading = 'lazy',
  priority = false,
  quality = 75,
  format = 'webp',
} = Astro.props as LazyImageProps;

const isImageMetadata = (
  value?: SupportedImageSource,
): value is ImageMetadata =>
  Boolean(
    value &&
      typeof value === 'object' &&
      'src' in value &&
      'width' in value &&
      'height' in value,
  );

const resolveRemoteSrc = () => {
  if (!src) return '';
  if (typeof src === 'string') return src;
  if (isImageMetadata(src)) return '';

  return getSanityImageUrl(src, { width, height, quality, format });
};

const remoteSrc = resolveRemoteSrc();
const shouldUseImageComponent = isImageMetadata(src);
const fallbackSrc =
  remoteSrc || `https://placehold.co/${width}x${height}?text=Image`;
---

<div
  class={cn(
    `image-wrapper w-[${width}px] h-[${height}px] bg-gray-100`,
    className,
  )}
>
  {
    shouldUseImageComponent ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        quality={quality}
        format={format}
        class={cn('block h-full w-full object-cover', imageClassName)}
      />
    ) : (
      <img
        src={fallbackSrc}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class={cn('block h-full w-full object-cover', imageClassName)}
      />
    )
  }
</div>
