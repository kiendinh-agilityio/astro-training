---
import { Link } from '@/components';
import { cn } from '@/utils';
import { legalLinks } from '@/mockData/common';

interface LegalProps {
  className?: string;
}

const { className } = Astro.props as LegalProps;
---

<ul
  class={cn(
    'flex flex-col gap-3 md:flex-row md:justify-between lg:gap-6 lg:items-center',
    className,
  )}
>
  {
    legalLinks.map((item) => (
      <li>
        <Link
          href={item.href}
          ariaLabel={item.label}
          className="text-sm leading-[21px] font-normal text-dark hover:hover:text-tertiary transition-colors duration-200"
        >
          {item.label}
        </Link>
      </li>
    ))
  }
</ul>
