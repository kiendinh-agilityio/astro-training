---
import { Image } from 'astro:assets';
import { Link, Heading, Paragraph, LazyImage } from '@/components';
import type { BlogPost } from '@/types';
import { cn } from '@/utils';

interface BlogCardProps {
  post: BlogPost;
  className?: string;
}

const { post, className } = Astro.props as BlogCardProps;
---

<Link
  href={`/blog/${post.slug}`}
  className={cn(
    'group block overflow-hidden rounded-xl transition-transform hover:scale-[1.02]',
    className,
  )}
  aria-label={`Read article: ${post.title}`}
  target="_self"
>
  <div
    class="relative aspect-[387/343] w-full overflow-hidden rounded-xl 2xl:aspect-[433/384]"
  >
    <LazyImage
      src={post.image}
      alt={post.title}
      width={384}
      height={340}
      imageClassName="h-full w-full object-cover transition-transform group-hover:scale-110"
    />
  </div>
  <>
    <Heading
      title={post.title}
      variant="h3"
      className="text-primary mt-4 mb-3 overflow-hidden font-bold text-ellipsis md:line-clamp-2 md:h-12 lg:my-5 lg:line-clamp-3 lg:h-24"
    />
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <Image
          src={post.author.avatar}
          alt={post.author.name}
          width={32}
          height={32}
          loading="lazy"
          format="webp"
        />
        <Paragraph size="xs" className="text-primary">
          {post.author.name}
        </Paragraph>
      </div>
      <Paragraph size="tiny" className="text-tertiary">{post.date}</Paragraph>
    </div>
  </>
</Link>
