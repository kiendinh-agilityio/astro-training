---
import { Link, PortableText, LazyImage } from '@/components';
import type { BlogPost } from '@/types';
import { cn } from '@/utils';

interface BlogCardProps {
  post: BlogPost;
  className?: string;
}

const { post, className } = Astro.props as BlogCardProps;
---

<Link
  href={`/blog/${post.slug}`}
  className={cn(
    'group block overflow-hidden rounded-xl transition-transform hover:scale-[1.02]',
    className,
  )}
  aria-label={`Read article: ${post.title}`}
  target="_self"
>
  <div
    class="relative aspect-[387/343] w-full overflow-hidden rounded-xl 2xl:aspect-[433/384]"
  >
    <LazyImage
      src={post.image}
      alt={post.title}
      width={384}
      height={340}
      imageClassName="h-full w-full object-cover transition-transform group-hover:scale-110"
    />
  </div>
  <>
    <PortableText
      value={post.title}
      fallback={post.title}
      style="h3"
      blockKey={`blog-card-title-${post.id}`}
      className="text-primary mt-4 mb-3 overflow-hidden font-bold text-ellipsis md:line-clamp-2 md:h-12 lg:my-5 lg:line-clamp-3 lg:h-24"
    />
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <LazyImage
          src={post.author.avatar}
          alt={post.author.name}
          width={32}
          height={32}
          className="overflow-hidden rounded-full"
          imageClassName="rounded-full object-cover"
        />
        <PortableText
          value={post.author.name}
          fallback={post.author.name}
          blockKey={`blog-card-author-${post.id}`}
          className="text-primary text-sm leading-5"
        />
      </div>
      <PortableText
        value={post.date}
        fallback={post.date}
        blockKey={`blog-card-date-${post.id}`}
        className="text-tertiary text-sm leading-4"
      />
    </div>
  </>
</Link>
