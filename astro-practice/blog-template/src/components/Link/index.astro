---
import { cn } from '@/utils';

export interface LinkProps {
  href: string;
  ariaLabel: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  rel?: string;
  className?: string;
}

const {
  href,
  ariaLabel,
  className,
  target = '_blank',
  rel = 'noopener noreferrer',
} = Astro.props as LinkProps;
---

<a
  href={href}
  aria-label={ariaLabel}
  target={target}
  rel={rel}
  class={cn(className)}
>
  <slot />
</a>
