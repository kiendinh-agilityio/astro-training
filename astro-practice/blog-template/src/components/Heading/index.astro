---
import { cn } from '@/utils';

interface HeadingProps {
  title: string;
  variant?: 'h2' | 'h3';
  className?: string;
}

const { title, variant = 'h2', className } = Astro.props as HeadingProps;

const sizeClasses = {
  h2: 'text-2xl leading-8 lg:text-[40px] lg:leading-14',
  h3: 'font-medium text-xl leading-7 lg:text-2xl lg:leading-8',
};

const computedClass = cn(sizeClasses[variant], className);

const Tag = variant;
---

<Tag class={computedClass}>
  {title}
</Tag>
