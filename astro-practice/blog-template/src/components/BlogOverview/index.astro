---
import { PortableText, Icons } from '@/components';
import { cn } from '@/utils';

interface Props {
  title: string;
  readTime?: string;
  date?: string;
  className?: string;
}

const { title, readTime, date, className }: Props = Astro.props;
---

<div class={cn('flex-1 text-center', className)}>
  <PortableText
    value={title}
    fallback={title}
    style="h2"
    blockKey={`overview-title-${title}`}
    className="text-primary mb-6 font-bold"
  />
  <div
    class="text-tertiary flex flex-row items-center justify-center gap-6 font-medium"
  >
    <div class="flex items-center gap-2">
      <Icons.Book />
      <PortableText
        value={readTime || '—'}
        fallback="—"
        blockKey={`overview-readtime-${title}`}
        className="text-sm leading-5 lg:text-base lg:leading-6"
      />
    </div>
    <span class="h-[12px] w-[12px] rounded-full border-[#f2f2f2] bg-[#f2f2f2]"
    ></span>
    <div class="flex items-center gap-2">
      <Icons.Calendar />
      <PortableText
        value={date || '—'}
        fallback="—"
        blockKey={`overview-date-${title}`}
        className="text-sm leading-5 lg:text-base lg:leading-6"
      />
    </div>
  </div>
</div>
