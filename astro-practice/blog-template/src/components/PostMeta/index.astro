---
import { PortableText, LazyImage } from '@/components';
import type { BlogAuthor } from '@/types';

interface Props {
  date: string;
  author: BlogAuthor;
}

const { date, author }: Props = Astro.props;
---

<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
  <PortableText
    value={date}
    fallback={date}
    blockKey={`post-meta-date-${date}`}
    className="text-sm leading-4 font-medium text-white lg:text-lg lg:leading-4"
  />
  <div class="flex items-center gap-3">
    <LazyImage
      src={author.avatar}
      alt={`${author.name} Avatar`}
      width={40}
      height={40}
      className="overflow-hidden rounded-full"
      imageClassName="rounded-full object-cover"
      loading="eager"
      priority={true}
    />
    <div class="flex flex-col">
      <PortableText
        value={author.name}
        fallback={author.name}
        blockKey={`post-meta-author-${author.name}`}
        className="text-sm leading-5 font-medium text-white lg:text-base lg:leading-6"
      />
      <PortableText
        value={author.role ?? 'Author'}
        fallback="Author"
        blockKey={`post-meta-role-${author.name}`}
        className="text-sm leading-5 text-white"
      />
    </div>
  </div>
</div>
