---
import { PortableText } from '@/components';
import type { BlogContent } from '@/types/';

interface Props {
  sections: BlogContent[];
}

const { sections } = Astro.props;
---

{
  sections.map((section: BlogContent) => (
    <div class="mb-3 last:mb-0">
      <PortableText
        value={section.country}
        fallback={section.country}
        style="h3"
        blockKey={`country-heading-${section.country}`}
        className="mb-3 font-semibold text-primary"
      />
      {section.listCountry?.length ? (
        <ul class="ml-6 list-disc space-y-1">
          {section.listCountry.map((dish: string) => (
            <li>
              <PortableText
                value={dish}
                fallback={dish}
                blockKey={`country-dish-${section.country}-${dish}`}
                className="text-sm leading-5 lg:text-base lg:leading-6 text-primary"
              />
            </li>
          ))}
        </ul>
      ) : null}
    </div>
  ))
}
