---
import { Heading, Paragraph, LazyImage } from '@/components';
import { cn } from '@/utils';
import CountriesContent from './CountriesContent/index.astro';
import type { ImageMetadata } from 'astro';
import type { BlogPost } from '@/types';

interface Props {
  introduction?: string;
  mainImage?: ImageMetadata;
  title: string;
  subtitle?: string;
  content: BlogPost['content'];
  conclusion?: string;
  className?: string;
}

const {
  introduction,
  mainImage,
  title,
  subtitle,
  content,
  conclusion,
  className,
}: Props = Astro.props;
---

<div class={cn('mt-8', className)}>
  {
    introduction && (
      <Paragraph size="md" className="text-primary mb-10 text-base">
        {introduction}
      </Paragraph>
    )
  }
  {
    mainImage && (
      <div class="mb-8 w-full overflow-hidden rounded-2xl lg:mb-12">
        <LazyImage
          src={mainImage}
          alt={title}
          width={1216}
          height={600}
          className="h-[206px] w-full lg:h-[405px]"
          imageClassName="object-cover"
          loading="eager"
          priority={true}
          format="webp"
        />
      </div>
    )
  }
  <div class="mb-3 lg:px-10">
    {
      subtitle && (
        <Paragraph className="border-l-[3px] pl-6 border-[#ddd] my-[52px] font-medium text-primary font-base">
          {subtitle}
        </Paragraph>
      )
    }
    {
      content?.type === 'countries' && content.sections.length > 0 ? (
        <CountriesContent sections={content.sections} />
      ) : null
    }
    {
      conclusion && (
        <div class="mt-3">
          <Heading variant="h3" title="Conclusion" />
          <Paragraph size="md" className="mt-3 text-base">
            {conclusion}
          </Paragraph>
        </div>
      )
    }
  </div>
</div>
