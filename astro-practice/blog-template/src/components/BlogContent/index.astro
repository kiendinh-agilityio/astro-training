---
import { PortableText, LazyImage, Paragraph, Link } from '@/components';
import { cn } from '@/utils';
import { ROUTER } from '@/constants';
import CountriesContent from './CountriesContent/index.astro';
import type { ImageMetadata } from 'astro';
import type { BlogPost } from '@/types';
import { ImagePlaceholder } from '@/assets/images';

interface Props {
  introduction?: string;
  mainImage?: ImageMetadata;
  title: string;
  subtitle?: string;
  content: BlogPost['content'];
  conclusion?: string;
  className?: string;
}

const {
  introduction,
  mainImage,
  title,
  subtitle,
  content,
  conclusion,
  className,
}: Props = Astro.props;

const imageSrc = mainImage ?? ImagePlaceholder;
const hasCountriesContent =
  content?.type === 'countries' && content.sections.length > 0;
---

{
  hasCountriesContent ? (
    <div class={cn('mt-8', className)}>
      {introduction && (
        <PortableText
          value={introduction}
          fallback={introduction}
          blockKey={`blog-introduction-${title}`}
          className="text-sm leading-6 lg:text-base text-primary mb-10"
        />
      )}

      <div class="mb-8 w-full overflow-hidden rounded-2xl lg:mb-12">
        <LazyImage
          src={imageSrc}
          alt={title}
          width={1216}
          height={600}
          className="h-[206px] w-full lg:h-[405px]"
          imageClassName="object-cover"
          loading="eager"
          priority={true}
          format="webp"
        />
      </div>
      <div class="mb-3 lg:px-10">
        {subtitle && (
          <PortableText
            value={subtitle}
            fallback={subtitle}
            blockKey={`blog-subtitle-${title}`}
            className="text-sm leading-5 lg:text-base lg:leading-6 border-l-[3px] pl-6 border-[#ddd] my-[52px] font-medium text-primary font-base"
          />
        )}

        <CountriesContent sections={content.sections} />

        {conclusion && (
          <div class="mt-3">
            <PortableText
              value="Conclusion"
              fallback="Conclusion"
              style="h3"
              blockKey={`blog-conclusion-heading-${title}`}
              className="font-semibold"
            />
            <PortableText
              value={conclusion}
              fallback={conclusion}
              blockKey={`blog-conclusion-${title}`}
              className="text-sm leading-6 lg:text-base mt-3"
            />
          </div>
        )}
      </div>
    </div>
  ) : (
    <div class={cn('mt-8', className)}>
      <div class="rounded-xl p-6 text-center">
        <Paragraph size="xl" className="mb-4 text-primary text-xl">
          Unable to display this article&apos;s content right now. Please try
          again later or return to the home page.
        </Paragraph>
        <Link
          href={ROUTER.HOME}
          ariaLabel="Back to home page"
          target="_self"
          className="inline-flex items-center justify-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary/90"
        >
          Back to Home
        </Link>
      </div>
    </div>
  )
}
