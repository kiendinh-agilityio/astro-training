---
import { LayoutContainer } from '@/layouts';
import { HeroBanner } from '@/assets/images';
import { LazyImage, PortableText, PostMeta } from '@/components';
import type { BlogPost } from '@/types';

interface HeroProps {
  post?: BlogPost | null;
}

const { post }: HeroProps = Astro.props;
const heroPost = post ?? null;
const defaultHeroTitle = 'Stay tuned for our next story';
---

<LayoutContainer>
  <section class="relative w-full pt-8 lg:pt-[72px]">
    <div class="relative w-full overflow-hidden rounded-2xl">
      <div class="relative w-full md:aspect-[768/400] lg:aspect-[1216/400]">
        <LazyImage
          src={heroPost?.mainImage || heroPost?.image || HeroBanner}
          alt={heroPost?.title ?? 'Featured article'}
          width={1216}
          height={400}
          imageClassName="h-[400px] w-full lg:h-full object-cover"
          quality={75}
          loading="eager"
          priority={true}
        />
        <div
          class="absolute inset-0 z-40 flex h-full flex-col justify-between px-4 py-7 lg:px-12 lg:pt-12 lg:pb-[42px]"
        >
          <PortableText
            value={heroPost?.title}
            fallback={defaultHeroTitle}
            style="h2"
            blockKey={heroPost?.id ?? 'hero-title'}
            className="font-bold text-white lg:max-w-3xl"
          />
          {
            heroPost && (
              <PostMeta
                date={heroPost.date}
                author={{
                  name: heroPost.author.name,
                  avatar: heroPost.author.avatar,
                  role: heroPost.author.role ?? 'Author',
                }}
              />
            )
          }
        </div>
      </div>
    </div>
  </section>
</LayoutContainer>
