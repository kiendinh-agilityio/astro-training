---
import { LayoutContainer } from '@/layouts';
import { PortableText, BlogCard, Paragraph, BlogList } from '@/components';
import type { BlogPost } from '@/types';

interface BlogSectionProps {
  posts?: BlogPost[];
  postsPerPage?: number;
}

const { posts = [], postsPerPage = 6 } = Astro.props as BlogSectionProps;

const totalPosts = posts.length;
---

<LayoutContainer className="py-8 lg:py-14">
  <section id="blog" class="w-full">
    <div class="mb-8 text-center lg:mb-12">
      <PortableText
        value="Trending Post"
        fallback="Trending Post"
        style="h2"
        blockKey="blog-trending-heading"
        className="text-primary mb-3 font-bold"
      />
      <Paragraph size="lg">
        Discover how innovation and creativity drive meaningful change
      </Paragraph>
    </div>
    {
      totalPosts > 0 ? (
        <>
          <div
            class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:min-h-[1050px] lg:grid-cols-3"
            data-blog-list-container
          >
            {posts.map((post, index) => (
              <div data-blog-card class={index >= postsPerPage ? 'hidden' : ''}>
                <BlogCard post={post} />
              </div>
            ))}
          </div>
          <BlogList
            client:load
            totalPosts={totalPosts}
            postsPerPage={postsPerPage}
          />
        </>
      ) : (
        <Paragraph className="text-center text-primary">
          No posts available yet. Please check back soon!
        </Paragraph>
      )
    }
  </section>
</LayoutContainer>
