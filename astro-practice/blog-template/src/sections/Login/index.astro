---
import { LoginForm, Heading, Paragraph } from '@/components';
import { LayoutContainer } from '@/layouts';
---

<section class="min-h-screen">
  <LayoutContainer
    className="flex min-h-[calc(100vh-120px)] items-center justify-center"
  >
    <div
      class="shadow-base w-fit rounded-xl border border-[#d9d9d9] bg-white p-16 lg:w-[578px]"
    >
      <Heading size="md" title="Welcome" className="font-bold" />
      <Paragraph className="text-tertiary my-[15px] font-bold">
        Enter your email and password to log in
      </Paragraph>
      <LoginForm client:load />
    </div>
  </LayoutContainer>
</section>
