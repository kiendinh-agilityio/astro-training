---
import { LanguageSwitcher, Logo, Navbar } from '@/components';
import { LayoutContainer } from '@/layouts';
import { getActiveSiteLanguage, getCachedMainNavigation } from '@/utils';

const { showNavbar = true } = Astro.props;
const navigationItems = showNavbar ? await getCachedMainNavigation() : [];
const shouldRenderNavbar = showNavbar && navigationItems.length > 0;
const currentLanguage = await getActiveSiteLanguage(Astro.cookies);
---

<header class="sticky top-0 z-50 w-full bg-white shadow-lg">
  <LayoutContainer className="py-3 md:py-4">
    <div class="flex items-center justify-between">
      <h1 class="max-w-fit">
        <Logo />
      </h1>
      <div class="flex items-center gap-4">
        {shouldRenderNavbar && <Navbar client:load items={navigationItems} />}
        <LanguageSwitcher client:load currentLanguage={currentLanguage} />
      </div>
    </div>
  </LayoutContainer>
</header>
