---
import { getCachedSiteSettings } from '@/utils';

const siteSettings = await getCachedSiteSettings();

const {
  title = siteSettings.title,
  description = siteSettings.description,
  image = '/banner.webp',
} = Astro.props;

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  Astro.site?.toString() ||
  'http://localhost:4321';
const canonicalUrl = new URL(
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\/?$/, '/'),
  siteUrl,
).href;
const url = canonicalUrl;

type IconLink = {
  rel: string;
  href: string;
  type?: string;
  sizes?: string;
};

const defaultSvgIcon = {
  href: '/favicon.svg',
  type: 'image/svg+xml',
};

const favicons = siteSettings.favicons ?? {};

const iconLinks: IconLink[] = [
  {
    rel: 'icon',
    href: favicons.svg?.url ?? defaultSvgIcon.href,
    type: favicons.svg?.type ?? defaultSvgIcon.type,
  },
];

if (favicons.ico?.url) {
  iconLinks.push({
    rel: 'icon',
    href: favicons.ico.url,
    type: favicons.ico.type ?? 'image/x-icon',
  });
}

if (favicons.png192?.url) {
  iconLinks.push({
    rel: 'icon',
    href: favicons.png192.url,
    type: favicons.png192.type ?? 'image/png',
    sizes: '192x192',
  });
}

if (favicons.png512?.url) {
  iconLinks.push({
    rel: 'icon',
    href: favicons.png512.url,
    type: favicons.png512.type ?? 'image/png',
    sizes: '512x512',
  });
}

const appleTouchIcon =
  favicons.appleTouch?.url ??
  favicons.png192?.url ??
  favicons.png512?.url ??
  favicons.svg?.url ??
  defaultSvgIcon.href;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Basic SEO -->
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href={`${Astro.site}sitemap-index.xml`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="Blog Template" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <!-- Icon -->
  {
    iconLinks.map((link) => (
      <link
        rel={link.rel}
        href={link.href}
        type={link.type}
        sizes={link.sizes}
      />
    ))
  }
  {
    appleTouchIcon && (
      <link rel="apple-touch-icon" href={appleTouchIcon} sizes="180x180" />
    )
  }
</head>
